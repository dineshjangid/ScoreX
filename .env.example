# Copy this file to .env and fill in the values for your environment.
# See DEPLOY.md for the full walkthrough (Azure AD app registration,
# internal CA cert, etc).

# --- Site ---
# The internal DNS name users will use to reach this app.
SITE_ADDRESS=csw.internal.yourcompany.com

# --- TLS ---
# Paths on the HOST machine (not inside the container) to a cert/key
# pair issued by your org's internal CA for SITE_ADDRESS.
TLS_CERT_PATH=/etc/csw/certs/csw.crt
TLS_KEY_PATH=/etc/csw/certs/csw.key

# --- CORS ---
# Only matters if the frontend is ever served from a different origin
# than the API (not the case in this docker-compose setup, where Caddy
# serves both on SITE_ADDRESS) — leave commented out to use the default.
# CORS_ORIGINS=https://csw.internal.yourcompany.com

# --- SAML SSO (Azure AD / Entra ID) ---
# Leave ALL of these blank to disable SSO — the app falls back to local
# username+password accounts (register via the login page) with no
# other changes needed.
#
# SAML_SP_ENTITY_ID and SAML_SP_ACS_URL are values YOU choose (derived
# from SITE_ADDRESS) and then give to your Azure AD admin when creating
# the Enterprise Application. SAML_IDP_* come the other way — from the
# Azure AD app's Federation Metadata once your admin creates it.
SAML_SP_ENTITY_ID=https://csw.internal.yourcompany.com/api/auth/saml/metadata
SAML_SP_ACS_URL=https://csw.internal.yourcompany.com/api/auth/saml/acs
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_X509_CERT=

# The SAML attribute name carrying the user's group Object IDs. Azure
# AD's default group-claim attribute is fine as-is unless your admin
# customized it.
# SAML_GROUP_ATTRIBUTE=http://schemas.microsoft.com/ws/2008/06/identity/claims/groups

# Azure AD group Object IDs, one per app role. Whichever of these a
# user belongs to becomes their role in the app on every login
# (approver takes priority over validator, which takes priority over
# analyst, if someone is in more than one).
SAML_GROUP_ANALYST_ID=
SAML_GROUP_VALIDATOR_ID=
SAML_GROUP_APPROVER_ID=

# Role for an SSO user who isn't in any of the groups above. Leave
# blank to reject their login instead (safer default for a governance
# tool — uncomment only if you want unmapped users let in as analysts).
# SAML_DEFAULT_ROLE=analyst
